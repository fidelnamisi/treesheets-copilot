{
  "name": "treesheets-copilot",
  "private": true,
  "version": "0.2.1",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --outfile=dist-electron/preload.cjs --format=cjs --external:electron",
    "dev": "concurrently -k \"cross-env BROWSER=none vite\" \"npm run electron:start\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json && npm run build:preload",
    "electron:start": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && npm run build:preload && electron .",
    "lint": "eslint .",
    "preview": "vite preview",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@types/chokidar": "^1.7.5",
    "@types/uuid": "^10.0.0",
    "@types/xml2js": "^0.4.14",
    "chokidar": "^5.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^11.0.2",
    "fast-glob": "^3.3.3",
    "openai": "^6.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uuid": "^13.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}